# 数据库连接（docker compose up -d 后保持默认即可；自建 PostgreSQL 改成你的连接串）
DATABASE_URL=postgres://aipeople:aipeople_dev@localhost:5433/aipeople

# 后端 API 端口
API_PORT=8787

# JWT 签名密钥（生产必须更换为强随机值）
JWT_SECRET=dev-secret-change-me

# 本地 Runner 连接的后端地址
RUNNER_BACKEND_URL=http://localhost:8787

# 本地数据目录（Runner 凭据库、素材等）
DATA_DIR=.local
